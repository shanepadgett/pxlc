pxlc 1

// A small palette-constrained robot icon exercising every Phase 1 primitive.
asset robot_icon
canvas 16 16

palette robot max 5 {
  transparent clear "."
  color outline "K" #172038
  color metal "M" #527a8a
  color light "L" #e8f3d6
  color accent "A" #e36b4f
}

background robot clear

layer body using robot {
  grid 2 2 {
    "..KKKKKKKK.."
    ".KMMMMMMMMK."
    "KMMMMMMMMMMK"
    "KMMMMMMMMMMK"
    "KMMKMMMMKMMK"
    "KMMMMMMMMMMK"
    "KMMMAAAAMMMK"
    "KMMMAMMAMMMK"
    "KMMMAAAAMMMK"
    ".KMMMMMMMMK."
    "..KKK..KKK.."
    "..KK....KK.."
  }
}

layer details using robot {
  pixel 8 0 accent
  hspan 7 1 3 accent
  vspan 8 1 2 accent
  rect 5 6 2 1 light
  rect 10 6 2 1 light
  hspan 6 13 4 outline
  vspan 3 13 2 outline
  rect 11 13 2 2 outline
}
